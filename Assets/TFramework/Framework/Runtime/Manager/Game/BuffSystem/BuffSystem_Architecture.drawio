        </mxCell>
        <mxCell id="buffdata_t_desc" value="• 继承 BaseBuffData&#xa;• 泛型 AddBuff(T) → OnAddBuff(T)&#xa;• 子类实现 OnAddBuff 处理叠层逻辑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="1">
