          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BaseBuffData ===== -->
        <mxCell id="bd_box" value="&lt;b&gt;BaseBuffData&lt;/b&gt;（抽象）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="540" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bd_desc" value="• BuffID / Order / Active / System&#xa;• effectList: List&lt;BaseBuffEffect&gt;&#xa;• SetActive(bool) → OnEnable / OnDisable&#xa;• OnUpdate(dt) → 遍历 effectList&#xa;• Effect() → 手动触发 effectList&#xa;• AddBuff(data) → Buff叠加（虚方法）&#xa;• Remove() → 通知 System 移除自身" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="460" height="110" as="geometry" />
